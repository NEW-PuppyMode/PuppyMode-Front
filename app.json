{
  "expo": {
    "name": "멍멍멍멍멍",
    "slug": "puppymode",
    "version": "1.3.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": ["puppymode", "puppymod"],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.anonymous.puppymode",
      "buildNumber": "5",
      "googleServicesFile": "./GoogleService-Info.plist",
      "appleTeamId": "AGQJU3FNWG"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/ic_launcher.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.puppymode",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      "@react-native-firebase/messaging",
      "./plugins/withDefaultNotificationChannel",
      [
        "@react-native-seoul/kakao-login",
        {
          "kakaoAppKey": "c3e8f77f2c2654beb51541c4161ff1aa",
          "kotlinVersion": "2.1.20"
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0FD380"
        }
      ],
      "expo-video",
      "expo-web-browser",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
