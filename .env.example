# 필수
EXPO_PUBLIC_API_URL=

# 선택
# ----- Amplitude API 키 (비어 있으면 이벤트 전송만 안 됨) -----
EXPO_PUBLIC_AMPLITUDE_API_KEY_DEV=
EXPO_PUBLIC_AMPLITUDE_API_KEY_PROD=

# ----- 목 테스트 (MSW) -----
# 켜기: 아래 EXPO_PUBLIC_MOCK_ACTIVATE 주석을 풀고 npx expo start -c (Metro 캐시 삭제)
# 끄기: ACTIVATE를 다시 주석 처리 (SCENARIO는 그대로 둬도 꺼져 있으면 무시됨)
# 시나리오 이름과 설명은 mocks/handlers.ts 의 scenarios 참고
# --------------------------
# EXPO_PUBLIC_MOCK_ACTIVATE=enable
EXPO_PUBLIC_MOCK_API_URL=
EXPO_PUBLIC_MOCK_SCENARIO=calendarMonths
